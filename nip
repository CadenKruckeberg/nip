#!/usr/bin/env bash

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_FILE="$XDG_CONFIG_HOME/nip/config"

if [ -z "$BRANCH" ] && [ -f "$CONFIG_FILE" ]; then
  . "$CONFIG_FILE"
fi

: "${BRANCH:=nixpkgs}"

help() {
  cat <<EOF
Usage: nip <command> [args...]

Commands:
  import              Read package list from stdin
  add <pkg...>        Add packages
  list                List added packages
  remove <pkg...>     Remove packages
  update [pkg...]     Update all or specified packages
EOF
}

if [ "$1" = "-h" ] || [ "$1" = "--help" ] || [ "$1" = "help" ]; then
  help

elif [ "$1" = "import" ]; then
  shift
  awk -v b="$BRANCH" '{print b "#" $0}' | nix profile add --stdin
  nix profile wipe-history >/dev/null 2>&1

elif [ "$1" = "add" ] || [ "$1" = "install" ]; then
  shift
  nix profile add "${@/#/$BRANCH#}"
  nix profile wipe-history >/dev/null 2>&1

elif [ "$1" = "list" ]; then
  SYSTEM="$(nix eval --impure --raw --expr builtins.currentSystem)"
  nix profile list --json | awk -v RS="${SYSTEM}." 'NR>1 {split($0, a, "\""); print a[1]}'

elif [ "$1" = "remove" ]; then
  shift
  nix profile remove "$@"
  nix profile wipe-history >/dev/null 2>&1

elif [ "$1" = "update" ]; then
  shift
  if [ $# -gt 0 ]; then
    nix profile upgrade "$@"
    nix profile wipe-history >/dev/null 2>&1
  else
    nix profile upgrade --all
    nix profile wipe-history >/dev/null 2>&1
    nix store gc
  fi

else
  help
  exit 1
fi
