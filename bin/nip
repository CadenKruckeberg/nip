#!/usr/bin/env bash

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_FILE="$XDG_CONFIG_HOME/nip/config"

BRANCH="nixpkgs"
GC_ON_UPDATE_ALL=0
WIPE_HISTORY=0

[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

help() {
  cat <<EOF
Usage: nip <command> [args...]

Commands:
  add <pkg...>        Add packages
  import              Read package list from stdin
  list                List added packages
  remove <pkg...>     Remove packages
  update [pkg...]     Update all or specified packages
EOF
}

maybe_wipe_history() {
  [ "$WIPE_HISTORY" -eq 1 ] && nix profile wipe-history >/dev/null 2>&1
}

maybe_gc() {
  [ "$GC_ON_UPDATE_ALL" -eq 1 ] && nix store gc
}

if [ "$1" = "-h" ] || [ "$1" = "--help" ] || [ "$1" = "help" ]; then
  help

elif [ "$1" = "add" ] || [ "$1" = "install" ]; then
  shift
  nix profile add "${@/#/$BRANCH#}"
  maybe_wipe_history

elif [ "$1" = "import" ]; then
  shift
  awk -v b="$BRANCH" '{print b "#" $0}' | nix profile add --stdin
  maybe_wipe_history

elif [ "$1" = "list" ]; then
  if ! command -v jq >/dev/null 2>&1; then
    echo "nip: 'jq' is required for 'list'. Install it with: nip add jq" >&2
    exit 1
  fi

  SYSTEM="$(nix eval --impure --raw --expr builtins.currentSystem)"
  nix profile list --json |
    jq -r --arg sys "$SYSTEM" '
      .elements
      | to_entries[]
      | select(.value.originalUrl | startswith("flake:nixpkgs"))
      | .value.attrPath
      | split($sys + ".")[1]
    '

elif [ "$1" = "remove" ]; then
  shift
  nix profile remove "$@"
  maybe_wipe_history

elif [ "$1" = "update" ]; then
  shift
  if [ $# -gt 0 ]; then
    nix profile upgrade "$@"
    maybe_wipe_history
  else
    nix profile upgrade --all
    maybe_wipe_history
    maybe_gc
  fi

else
  help
  exit 1
fi
