#compdef nip

_nip() {
  local -a commands
  commands=(
    "add:Add packages"
    "clean:Wipe history and collect garbage"
    "import:Read package list from stdin"
    "install:Alias for add"
    "list:List added packages"
    "remove:Remove packages"
    "update:Update packages"
    "help:Show help"
  )

  if [[ "$PREFIX" == -* ]]; then
    _arguments \
      '-h[Show help]' \
      '--help[Show help]'
    return
  fi

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi

  local cmd="${words[2]}"

  if [[ "$cmd" == "remove" || "$cmd" == "update" ]]; then
    local -a pkgs
    pkgs=("${(@f)$(nip list 2>/dev/null)}")
    _describe 'packages' pkgs
  fi
}

compdef _nip nip
