#compdef nip

_nip() {
  local -a commands
  commands=(
    "add:Add package(s)"
    "clean:Wipe history and collect garbage"
    "import:Add package(s) from package list through stdin"
    "install:Alias for add"
    "list:List added package(s)"
    "remove:Remove package(s)"
    "search:Search for packages whose name contains what you provide"
    "update:Update all or specified package(s)"
    "help:Show help"
  )

  if [[ "$PREFIX" == -* ]]; then
    _arguments \
      '-h[Show help]' \
      '--help[Show help]'
    return
  fi

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi

  local cmd="${words[2]}"

  if [[ "$cmd" == "remove" || "$cmd" == "update" ]]; then
    local -a pkgs
    pkgs=("${(@f)$(nip list 2>/dev/null)}")
    _describe 'packages' pkgs
  fi
}

compdef _nip nip
